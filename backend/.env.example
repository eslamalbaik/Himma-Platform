APP_NAME=Himma
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

# The Next.js frontend proxies /api/* here server-side, so requests arrive with Host=127.0.0.1:8000
# but Origin=the frontend. Same-origin checks on writes compare against FRONTEND_URL, not the Host.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (XAMPP locally). Tests use a separate database, himma_test (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=himma
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=himma_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# First platform owner account, created by: php artisan db:seed
SEED_ADMIN_EMAIL=admin@himma.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME_AR="مدير المنصة"
SEED_ADMIN_NAME_EN="Platform Owner"

BROADCAST_CONNECTION=log
# Uploaded files: `public` locally (php artisan storage:link), `s3` in production.
FILESYSTEM_DISK=public
# Background jobs (emails, exports, billing). Run a worker: php artisan queue:work
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=himma

# Redis (Memurai on Windows). predis needs no PHP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@himma.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
