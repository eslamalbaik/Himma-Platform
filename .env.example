# Database. Development uses a local SQLite file; production will use MySQL.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Use a random value of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-a-random-value-of-at-least-32-characters"

# First super admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@himma.local"
SEED_ADMIN_PASSWORD=""
